@page
@model spotify.Pages.Admin.CancionesAdminModel
@{
    ViewData["Title"] = "Subir Canción";
}

<style>
    body { background: linear-gradient(to bottom, #121212, #000000); min-height: 100vh; color: white; }
    .form-container { background-color: #181818; border-radius: 10px; padding: 30px; box-shadow: 0 0 20px rgba(0,0,0,0.5); }
    .input-line { background: transparent; border: none; border-bottom: 1px solid #444; border-radius: 0; color: white; }
    .input-line:focus { background: transparent; box-shadow: none; border-bottom: 1px solid #1DB954; color: white; }
    .file-input { background-color: #222; color: white; border: none; }
    
    .btn-spotify { background-color: #1DB954; color: black; border: none; font-weight: bold; border-radius: 50px; transition: 0.3s; }
    .btn-spotify:hover { background-color: #1ed760; transform: scale(1.02); color: black; }
    
    .btn-cancelar { border: 1px solid #555; color: white; font-weight: bold; border-radius: 50px; transition: 0.3s; }
    .btn-cancelar:hover { background-color: rgba(255,255,255,0.1); border-color: white; color: white; }
</style>

<div class="container py-5">
    <div class="row align-items-center">
        <div class="col-lg-7">
            <div class="form-container">
                <h3 class="text-center fw-bold mb-4">Nueva Canción</h3>

                <form method="post" enctype="multipart/form-data">
                    <div class="mb-4">
                        <label class="small fw-bold text-secondary">TÍTULO</label>
                        <input type="text" id="txtName" class="form-control input-line" asp-for="Nombre" required />
                    </div>

                    <div class="mb-4">
                        <label class="small fw-bold text-secondary">ARTISTA</label>
                        <input type="text" id="txtArtist" class="form-control input-line" asp-for="Artista" required />
                    </div>

                    <div class="mb-4">
                        <label class="small fw-bold text-secondary">ARCHIVO MP3</label>
                        <input type="file" class="form-control file-input" asp-for="Archivo" accept="audio/*" required />
                    </div>

                    <div class="mb-4">
                        <label class="small fw-bold text-secondary">PORTADA (IMAGEN)</label>
                        <input type="file" id="imgInput" class="form-control file-input" asp-for="Portada" accept="image/*" required />
                    </div>

                    <div class="row mt-5">
                        <div class="col-6">
                            <a asp-page="/Inicio" class="btn btn-cancelar w-100 py-2 text-decoration-none text-center d-block">
                                CANCELAR
                            </a>
                        </div>
                        <div class="col-6">
                            <button type="submit" class="btn btn-spotify w-100 py-2">
                                CONFIRMAR
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div class="col-lg-5 text-center d-none d-lg-block">
            <h5 class="text-secondary fw-bold mb-4">PREVISUALIZACIÓN</h5>
            <div class="spotify-card m-auto text-start p-3" style="width: 230px; background: #181818; border-radius: 8px;">
                <div class="position-relative mb-3">
                    <img id="previewImage" src="https://via.placeholder.com/300/282828/fff?text=Portada" class="img-fluid rounded shadow w-100" style="aspect-ratio:1/1; object-fit:cover;">
                    <button class="play-btn shadow" style="opacity:1; transform:translateY(0);"><i class="bi bi-play-fill fs-3"></i></button>
                </div>
                <h6 id="previewName" class="fw-bold text-white mb-1 text-truncate">Título</h6>
                <p id="previewArtist" class="text-secondary small mb-0 text-truncate">Artista</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Actualización en tiempo real sin recargar página
        const txtName = document.getElementById('txtName');
        const txtArtist = document.getElementById('txtArtist');
        const imgInput = document.getElementById('imgInput');

        txtName.addEventListener('input', (e) => document.getElementById('previewName').innerText = e.target.value || "Título");
        txtArtist.addEventListener('input', (e) => document.getElementById('previewArtist').innerText = e.target.value || "Artista");

        imgInput.addEventListener('change', function() {
            const file = this.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = (e) => document.getElementById('previewImage').src = e.target.result;
                reader.readAsDataURL(file);
            }
        });
    </script>
}