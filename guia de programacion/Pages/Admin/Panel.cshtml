@page "{nombre}"
@model spotify.Pages.PerfilViewModel
@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Artista - " + Model.NombreArtista;


    var sesionId = HttpContext.Session.GetString("UsuarioId");
    bool esMiPerfil = !string.IsNullOrEmpty(sesionId) && sesionId == Model.ArtistaInfo?.Id.ToString();
}

<div class="artist-profile-wrapper">


    <div class="px-4 py-3 d-flex align-items-center gap-4">

        @if (esMiPerfil) {
            <a asp-page="/CancionVerificado" class="btn btn-outline-light rounded-pill px-4 fw-bold btn-sm">SUBIR NUEVA MÚSICA</a>
        }
    </div>

    <div class="px-4 pb-5">
        <h3 class="fw-bold text-white mb-3 fs-4">Popular</h3>
        <table class="table table-dark table-hover align-middle mb-0" style="--bs-table-bg: transparent;">
            <thead>
                <tr class="text-secondary small text-uppercase border-bottom border-secondary border-opacity-25">
                    <th style="width: 40px;">#</th>
                    <th>Título</th>
                    <th>Álbum</th>
                    <th class="text-end" style="width: 150px;"><i class="bi bi-clock"></i></th>
                </tr>
            </thead>
            <tbody>
                @{ int j = 1; }
                @foreach (var cancion in Model.CancionesArtista)
                {
                    <tr class="track-row">
                        <td class="text-secondary text-center small pointer" onclick="window.location.href='/Reproductor/@cancion.Id?contexto=artista&valor=@Uri.EscapeDataString(Model.NombreArtista)'">
                            <span class="index-num">@j</span>
                            <i class="bi bi-play-fill text-white d-none play-icon-row"></i>
                        </td>
                        <td class="pointer" onclick="window.location.href='/Reproductor/@cancion.Id?contexto=artista&valor=@Uri.EscapeDataString(Model.NombreArtista)'">
                            <div class="d-flex align-items-center gap-3">
                                <img src="@cancion.RutaPortada" class="rounded" style="width: 40px; height: 40px; object-fit: cover;">
                                <div>
                                    <p class="mb-0 text-white fw-bold song-title small">@cancion.Titulo</p>
                                </div>
                            </div>
                        </td>
                        <td class="text-secondary small">@cancion.Album</td>
                        <td class="text-secondary text-end small">
                            <div class="d-flex align-items-center justify-content-end gap-3">
                                <span>@cancion.Duracion.ToString(@"m\:ss")</span>

                           
                                @if (esMiPerfil)
                                {
                                    <form method="post" asp-page-handler="EliminarCancion" asp-route-id="@cancion.Id" 
                                          onsubmit="return confirm('¿Borrar esta canción permanentemente?');" class="d-inline">
                                        <button class="btn btn-link text-danger p-0 border-0 btn-delete-track" title="Eliminar">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                    j++;
                }
            </tbody>
        </table>
    </div>
</div>

@section Styles {
    <style>


        .track-row:hover .btn-delete-track { opacity: 1; visibility: visible; }
        .btn-delete-track { 
            opacity: 0; 
            visibility: hidden; 
            transition: 0.2s; 
            font-size: 1.1rem;
        }
        .btn-delete-track:hover { color: #ff4d4d !important; transform: scale(1.2); }
        .pointer { cursor: pointer; }
    </style>
}