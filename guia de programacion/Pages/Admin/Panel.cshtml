@page
@model spotify.Pages.Admin.PanelModel
@{
    ViewData["Title"] = "Panel de Administración";
}

<style>
    .track-row {
        transition: background-color 0.3s ease;
        border-bottom: 1px solid #282828 !important;
    }

        .track-row:hover {
            background-color: #282828 !important;
        }

    .img-track-admin {
        width: 50px;
        height: 50px;
        object-fit: cover;
        border-radius: 6px;
        border: 1px solid #333;
    }

    .input-edit-title {
        background-color: #181818 !important;
        border: 1px solid #333 !important;
        color: white !important;
        font-size: 0.9rem;
        border-radius: 4px;
    }

        .input-edit-title:focus {
            border-color: #1db954 !important;
            box-shadow: none;
        }

    .badge-track {
        font-size: 0.7rem;
        letter-spacing: 1px;
    }
</style>

<div class="main-content p-5">

    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h1 class="fw-bold text-white mb-1">Panel de Control Musical</h1>
            <p class="text-secondary small">Gestiona el catálogo de canciones, corrige metadatos y modera contenido.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-page="/Admin/ListaUsuarios" class="btn btn-outline-info rounded-pill px-4 fw-bold">
                <i class="bi bi-people me-2"></i>Gestión de Usuarios
            </a>
            <a asp-page="/inicio" class="btn btn-outline-light rounded-pill px-4 fw-bold border-secondary">
                Volver al Inicio
            </a>
        </div>
    </div>

  
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="p-3 rounded-3" style="background: #181818; border: 1px solid #282828;">
                <span class="text-secondary small d-block mb-1 text-uppercase fw-bold" style="letter-spacing: 1px;">En Catálogo</span>
                <span class="h3 fw-bold text-white">@Model.Canciones.Count <small class="fs-6 text-secondary">tracks</small></span>
            </div>
        </div>
    </div>


    <div class="spotify-card shadow-lg" style="background-color: #121212; border-radius: 15px; border: 1px solid #282828; overflow: hidden;">
        <div class="table-responsive">
            <table class="table table-dark align-middle mb-0">
                <thead>
                    <tr class="text-secondary" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1.5px; background-color: #181818;">
                        <th class="border-0 px-4 py-3">Canción / Portada</th>
                        <th class="border-0 py-3">Artista & Metadatos</th>
                        <th class="border-0 text-end px-4 py-3">Acciones de Moderación</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cancion in Model.Canciones)
                    {
                        <tr class="track-row">
                  
                            <td class="px-4 py-3">
                                <div class="d-flex align-items-center">
                                    <img src="@cancion.RutaPortada" class="img-track-admin me-3 shadow" />
                                    <div style="width: 100%; max-width: 300px;">
                                        <form method="post" asp-page-handler="ActualizarNombre" class="d-flex gap-2">
                                            <input type="hidden" name="id" value="@cancion.Id" />
                                            <input type="text" name="nuevoNombre" class="form-control form-control-sm input-edit-title"
                                                   value="@cancion.Titulo" />
                                            <button type="submit" class="btn btn-sm btn-outline-success border-0" title="Guardar cambios">
                                                <i class="bi bi-check2-circle fs-5"></i>
                                            </button>
                                        </form>
                                        <span class="text-secondary" style="font-size: 0.7rem;">ID Track: #@cancion.Id</span>
                                    </div>
                                </div>
                            </td>

                   
                            <td>
                                <div class="d-flex flex-column gap-1">
                                    <span class="text-white fw-semibold">@cancion.Artista</span>
                                    <div class="d-flex gap-2">
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 rounded-pill badge-track">
                                            MP3
                                        </span>
                                        @if (cancion.Titulo.ToLower().Contains("remix"))
                                        {
                                            <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 rounded-pill badge-track">
                                                REMIX
                                            </span>
                                        }
                                    </div>
                                </div>
                            </td>

                            <td class="text-end px-4">
                                <div class="d-flex justify-content-end gap-2">
                           
                                    <a href="@cancion.RutaArchivo" target="_blank" class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-bold shadow-sm">
                                        <i class="bi bi-headphones me-1"></i> Probar
                                    </a>

                       
                                    <form method="post" asp-page-handler="Eliminar" asp-route-id="@cancion.Id"
                                          onsubmit="return confirm('¿Borrar canción permanentemente del sistema?');">
                                        <button class="btn btn-sm btn-outline-danger rounded-circle p-2" title="Eliminar del Catálogo">
                                            <i class="bi bi-trash3 px-1"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>