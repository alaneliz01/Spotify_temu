@page
@model spotify.Pages.Admin.Pruebacancion1Model
@{
    ViewData["Title"] = "Biblioteca de Canciones";
}

<div class="main-content p-5">
    @* Encabezado *@
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h1 class="fw-bold text-white mb-1">Biblioteca de Música</h1>
            <p class="text-secondary small">Gestiona el catálogo de canciones disponibles en la plataforma.</p>
        </div>
        <a asp-page="/Admin/CancionesAdmin" class="btn btn-warning rounded-pill px-4 fw-bold shadow">
            <i class="bi bi-plus-lg me-2"></i>Subir Nueva
        </a>
    </div>

    @* Grid de Canciones *@
    <div class="row g-4">
        @foreach (var c in Model.Canciones)
        {
            <div class="col-6 col-md-4 col-lg-3 col-xl-2">
                <div class="spotify-card h-100 d-flex flex-column">
                    @* Contenedor de Imagen con Botón de Play Falso (Estético) *@
                    <div class="position-relative mb-3">
                        @if (!string.IsNullOrEmpty(c.RutaPortada))
                        {
                            <img src="@c.RutaPortada" class="img-fluid rounded shadow" style="aspect-ratio: 1/1; object-fit: cover; width: 100%;">
                        }
                        else
                        {
                            <div class="rounded d-flex align-items-center justify-content-center shadow" 
                                 style="aspect-ratio: 1/1; background: #282828; color: #555;">
                                <i class="bi bi-music-note-beamed fs-1"></i>
                            </div>
                        }
                        @* Botón de play que aparece al hacer hover (usando tu CSS) *@
                        <button class="play-btn shadow"><i class="bi bi-play-fill fs-3"></i></button>
                    </div>

                    @* Información de la Canción *@
                    <div class="mb-3">
                        <h6 class="fw-bold text-white text-truncate mb-1" title="@c.Titulo">@c.Titulo</h6>
                        <p class="text-secondary small text-truncate mb-0">@c.Artista</p>
                    </div>

                    @* Reproductor Minimalista *@
                    <div class="mt-auto">
                        <audio controls class="w-100 custom-audio-player">
                            <source src="@c.RutaArchivo" type="audio/mpeg" />
                        </audio>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    /* Estilo para que el reproductor nativo no se vea tan blanco/tosco */
    .custom-audio-player {
        height: 30px;
        filter: invert(100%) hue-rotate(180deg) brightness(1.5);
        opacity: 0.6;
        transition: opacity 0.3s;
    }
    .custom-audio-player:hover {
        opacity: 1;
    }
    
    /* Ajuste para que las tarjetas tengan un tamaño uniforme */
    .spotify-card {
        min-height: 350px;
    }
</style>