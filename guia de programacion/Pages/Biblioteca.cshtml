@page
@model spotify.Pages.BibliotecaModel
@{
    ViewData["ActivePage"] = "biblioteca";
    ViewData["Title"] = "Tu Biblioteca - Spotify";
}

<div class="flex-grow-1 text-white">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Tu Biblioteca</h2>
        <button class="btn btn-success rounded-pill fw-bold px-4 shadow" data-bs-toggle="modal" data-bs-target="#modalPlaylist">
            <i class="bi bi-plus-lg me-2"></i> Crear Playlist
        </button>
    </div>

    <div class="row g-4 mb-5">
        @* CARD DE FAVORITOS - Mejorada visualmente *@
        <div class="col-12 col-md-6 col-xl-4">
            <a asp-page="/Favoritas" class="text-decoration-none">
                <div class="p-4 rounded-3 h-100 d-flex flex-column justify-content-end shadow-lg liked-songs-banner">
                    <div class="mb-4">
                        <div class="heart-icon-container d-flex align-items-center justify-content-center shadow">
                            <i class="bi bi-heart-fill fs-2 text-white"></i>
                        </div>
                    </div>
                    <h1 class="fw-bolder text-white mb-1" style="font-size: 2.8rem; letter-spacing: -1.5px;">Tus me gusta</h1>
                    <p class="mb-0 fw-bold text-white opacity-75">Canciones guardadas</p>
                </div>
            </a>
        </div>

        @* LISTA DE PLAYLISTS - Ahora apuntan a la página de detalles *@
        @foreach (var p in Model.MisPlaylists)
        {
            <div class="col-6 col-md-4 col-lg-3 col-xl-2">
                <a asp-page="/Playlist" asp-route-id="@p.Id" class="text-decoration-none">
                    <div class="card bg-dark border-0 p-3 h-100 hover-card shadow">
                        <img src="@(string.IsNullOrEmpty(p.Fotoplaylist) ? "/img/default-playlist.png" : p.Fotoplaylist)"
                             class="card-img-top rounded shadow mb-3" style="aspect-ratio: 1/1; object-fit: cover;">
                        <div class="card-body p-0">
                            <h6 class="fw-bold text-white mb-1 text-truncate">@p.Nombre</h6>
                            <p class="text-secondary small mb-0">Playlist • @p.PlaylistCanciones.Count temas</p>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
</div>

@* MODAL CREAR PLAYLIST *@
<div class="modal fade" id="modalPlaylist" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-secondary shadow-lg">
            <form method="post" asp-page-handler="CrearPlaylist" enctype="multipart/form-data">
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold">Nueva Playlist</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="small fw-bold text-secondary">NOMBRE</label>
                        <input type="text" name="nombrePlaylist" class="form-control bg-black text-white border-secondary" placeholder="Mi playlist #1" required>
                    </div>
                    <div class="mb-3">
                        <label class="small fw-bold text-secondary">PORTADA</label>
                        <input type="file" name="fotoPlaylist" class="form-control bg-black text-white border-secondary" accept="image/*">
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold shadow">CREAR</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .liked-songs-banner {
            background: linear-gradient(135deg, #450af5 0%, #8e8ee5 100%);
            transition: 0.3s ease;
            min-height: 240px;
            cursor: pointer;
        }
        .liked-songs-banner:hover { filter: brightness(1.1); transform: scale(1.01); }
        
        .heart-icon-container {
            width: 64px; height: 64px;
            background: linear-gradient(135deg, rgba(255,255,255,0.2), rgba(255,255,255,0.05));
            border-radius: 8px;
        }

        .hover-card { 
            background-color: #181818 !important; 
            transition: background-color 0.3s ease, transform 0.3s ease; 
        }
        .hover-card:hover { 
            background-color: #282828 !important; 
            transform: translateY(-8px); 
        }
    </style>
}