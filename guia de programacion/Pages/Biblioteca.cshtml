@page
@model spotify.Pages.BibliotecaModel
@{
    ViewData["ActivePage"] = "biblioteca";
    ViewData["Title"] = "Tu Biblioteca - Spotify";
}

<div class="flex-grow-1 p-4 text-white">
    
    <div class="d-flex gap-2 mb-4">
        <button class="btn-pill active">Playlists</button>
        <button class="btn-pill">Artistas</button>
        <button class="btn-pill">Álbumes</button>
    </div>

    <div class="d-flex justify-content-between align-items-end mb-3">
        <h4 class="fw-bold mb-0">Escuchadas recientemente</h4>
        <a href="#" class="text-secondary small fw-bold text-decoration-none hover-white">Ver todo</a>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-12 col-md-8 col-lg-6 col-xl-4">
            <div class="liked-songs-card p-4 h-100 d-flex flex-column justify-content-end shadow-lg">
                <div class="mb-4 mt-2">
                    <i class="bi bi-heart-fill fs-1 text-white"></i>
                </div>
                <h2 class="fw-bold text-white">Tus me gusta</h2>
                <p class="mb-0 fw-semibold text-white">85 canciones guardadas</p>
            </div>
        </div>

        <div class="col-6 col-md-4 col-lg-3 col-xl-2">
            <div class="spotify-card p-3 h-100">
                <div class="img-container position-relative mb-3">
                    <img src="https://via.placeholder.com/300/ff6b6b/fff?text=Weeknd" class="img-fluid rounded shadow-lg">
                    <button class="play-btn shadow"><i class="bi bi-play-fill"></i></button>
                </div>
                <h6 class="fw-bold mb-1 text-truncate text-white">Blinding Lights</h6>
                <p class="text-secondary small">The Weeknd</p>
            </div>
        </div>
    </div>

    <h4 class="fw-bold mb-4">Tus Listas</h4>
    
    <div class="row g-2">
        <div class="col-12">
            <div class="list-item-container d-flex align-items-center p-2 rounded cursor-pointer">
                <div class="list-img me-3" style="background: linear-gradient(135deg, #4568dc, #b06ab3);">
                    <i class="bi bi-music-note-beamed text-white"></i>
                </div>
                <div class="flex-grow-1">
                    <h6 class="mb-0 fw-bold text-white">Mi lista principal</h6>
                    <span class="text-secondary small">Playlist • 45 canciones</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        /* Estilos específicos que faltaban en site.css */
        .btn-pill {
            background-color: #2a2a2a; color: white; border-radius: 500px;
            padding: 6px 16px; font-size: 0.85rem; font-weight: 600; border: none;
            transition: 0.2s;
        }
        .btn-pill.active { background-color: white; color: black; }
        .btn-pill:hover:not(.active) { background-color: #3e3e3e; }

        .liked-songs-card {
            background: linear-gradient(135deg, #450af5 0%, #8e8ee5 100%);
            border-radius: 8px; cursor: pointer; transition: 0.3s;
            min-height: 220px;
        }
        .liked-songs-card:hover { transform: scale(1.02); }

        .list-item-container:hover { background-color: rgba(255,255,255,0.1); transition: 0.2s; }
        .list-img { width: 48px; height: 48px; border-radius: 4px; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; }
        .cursor-pointer { cursor: pointer; }
    </style>
}