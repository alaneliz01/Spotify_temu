@page
@model spotify.Pages.BuscarModel
@{
    ViewData["ActivePage"] = "buscar";
    ViewData["Title"] = "Buscar - Spotify";
}

<div class="search-header mb-5">
    <form method="get" class="search-input-wrapper">
        <i class="bi bi-search search-icon"></i>
        <input type="text" name="TerminoBusqueda" class="search-input" 
               placeholder="¿Qué quieres escuchar hoy?" 
               value="@Model.TerminoBusqueda" 
               list="sugerenciasData"
               autocomplete="off">

        <datalist id="sugerenciasData">
            @foreach (var sugerencia in Model.Sugerencias)
            {
                <option value="@sugerencia"></option>
            }
        </datalist>
    </form>
</div>

@if (!string.IsNullOrEmpty(Model.TerminoBusqueda))
{
    <div class="results-section animate-fade-in">
        <div class="d-flex justify-content-between align-items-end mb-4">
            <h3 class="fw-bold text-white mb-0">Resultados para "@Model.TerminoBusqueda"</h3>
            <a asp-page="/Buscar" class="text-secondary small text-decoration-none">Ver todo</a>
        </div>

        <div class="row g-4 mb-5">
            @if (Model.Resultados.Any())
            {
                @foreach (var cancion in Model.Resultados)
{
                    <div class="col-6 col-md-4 col-lg-3 col-xl-2">
                        <div class="spotify-card p-3 h-100">
                            @* Pasamos el contexto 'genero' si el usuario buscó por categoría *@
                            <a asp-page="/Reproductor" asp-route-id="@cancion.Id" asp-route-contexto="genero" asp-route-valor="@cancion.Genero" class="text-decoration-none">
                                <div class="img-container position-relative mb-3">
                                    <img src="@cancion.RutaPortada" class="img-fluid rounded shadow-lg">
                                    <div class="play-btn-float shadow"><i class="bi bi-play-fill"></i></div>
                                </div>
                            </a>
                            <h6 class="fw-bold text-white mb-0">@cancion.Titulo</h6>
                            <a asp-page="/PerfilView" asp-route-nombre="@cancion.Artista" class="artist-link small">@cancion.Artista</a>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 py-5 text-center bg-dark rounded-4 bg-opacity-25 border border-secondary border-opacity-10">
                    <i class="bi bi-search text-secondary display-1 opacity-25"></i>
                    <p class="text-secondary mt-3 fs-5">No encontramos nada para "@Model.TerminoBusqueda"</p>
                </div>
            }
        </div>
    </div>
}
else
{
    <h3 class="fw-bold mb-4 text-white">Explorar todo</h3>
    <div class="row g-4 mb-5">
        @{
            // Mapeo de géneros según tu lista de opciones
            var categorias = new[] { 
                new { T = "Pop", C = "#1E3264", I = "🎤" },
                new { T = "Rock", C = "#E8115B", I = "🎸" },
                new { T = "Urban", C = "#8D67AB", I = "🏙️" }, // Urbano
                new { T = "Lo-fi", C = "#503750", I = "☕" },
                new { T = "Salsa", C = "#FF4632", I = "💃" },
                new { T = "Podcasts", C = "#E13300", I = "🎙️" }
            };
        }
        @foreach (var cat in categorias)
        {
            <div class="col-6 col-md-4 col-lg-3 col-xl-2">
                @* El asp-route-TerminoBusqueda envía el género exacto al OnGet *@
                <a asp-page="/Buscar" asp-route-TerminoBusqueda="@cat.T" class="text-decoration-none">
                    <div class="category-card shadow-sm" style="background-color: @cat.C;">
                        <span class="category-title">@cat.T</span>
                        <div class="category-emoji">@cat.I</div>
                    </div>
                </a>
            </div>
        }
    </div>
}

@section Styles {
    <style>
        /* Mejoras visuales del buscador */
        .search-input-wrapper { position: relative; max-width: 500px; }
        .search-icon { position: absolute; left: 18px; top: 50%; transform: translateY(-50%); color: #000; font-size: 1.4rem; z-index: 5; }
        .search-input { width: 100%; padding: 14px 20px 14px 55px; border-radius: 500px; border: none; background-color: #fff; color: #000; font-weight: 600; font-size: 0.95rem; outline: none; transition: 0.2s; }
        
        /* Tarjetas de Género (Inclinación de emoji estilo Spotify) */
        .category-card { aspect-ratio: 1 / 1; border-radius: 12px; padding: 18px; position: relative; overflow: hidden; cursor: pointer; transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        .category-card:hover { transform: scale(1.05); filter: brightness(1.2); }
        .category-title { color: white; font-size: 1.6rem; font-weight: 800; position: relative; z-index: 2; letter-spacing: -1px; }
        .category-emoji { position: absolute; font-size: 5.5rem; bottom: -15px; right: -15px; transform: rotate(25deg); opacity: 0.8; filter: drop-shadow(0 8px 10px rgba(0,0,0,0.4)); z-index: 1; }

        .spotify-card { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05); border-radius: 10px; transition: 0.3s; }
        .spotify-card:hover { background: rgba(255,255,255,0.08); transform: translateY(-5px); }
        .artist-link { color: #b3b3b3; text-decoration: none; }
        .artist-link:hover { color: #fff; text-decoration: underline; }

        .play-btn-float { position: absolute; bottom: 12px; right: 12px; width: 48px; height: 48px; border-radius: 50%; background: #1ed760; color: #000; display: flex; align-items: center; justify-content: center; opacity: 0; transform: translateY(10px); transition: 0.3s; }
        .spotify-card:hover .play-btn-float { opacity: 1; transform: translateY(0); }

        .album-img { aspect-ratio: 1/1; object-fit: cover; width: 100%; }
        .animate-fade-in { animation: fadeIn 0.4s ease-out; }
        @@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    </style>
}