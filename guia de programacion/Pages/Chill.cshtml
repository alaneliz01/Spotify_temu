@page
@model spotify.Pages.ChillModel
@{
    ViewData["ActivePage"] = "chill";
    ViewData["Title"] = "Chill - SPOTIFY";
}

<div class="chill-container p-4 rounded-3" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 100%;">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold text-white">Modo Chill 🌙</h1>

        <a href="/" class="btn btn-dark rounded-pill px-3">
            <i class="bi bi-arrow-left"></i>
        </a>
    </div>

    <p class="text-white-50 mb-5">Relájate con sonidos suaves, perfectos para estudiar o desconectarte del mundo.</p>

    <div class="row g-4">
        <div class="col-md-4 col-lg-3">
            <div class="card bg-dark border-0 text-white h-100 shadow">
                <img src="https://via.placeholder.com/300x200/6c5ce7/fff?text=LoFi" class="card-img-top">
                <div class="card-body">
                    <h5>LoFi Beats</h5>
                    <p class="text-white-50">Para concentrarte sin estrés</p>
                    <button class="btn btn-success w-100 rounded-pill">
                        <i class="bi bi-play-fill"></i> Reproducir
                    </button>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-lg-3">
            <div class="card bg-dark border-0 text-white h-100 shadow">
                <img src="https://via.placeholder.com/300x200/00b894/fff?text=Ambient" class="card-img-top">
                <div class="card-body">
                    <h5>Ambient</h5>
                    <p class="text-white-50">Sonidos relajantes</p>
                    <button class="btn btn-success w-100 rounded-pill">
                        <i class="bi bi-play-fill"></i> Reproducir
                    </button>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-lg-3">
            <div class="card bg-dark border-0 text-white h-100 shadow">
                <img src="https://via.placeholder.com/300x200/0984e3/fff?text=Piano" class="card-img-top">
                <div class="card-body">
                    <h5>Piano Chill</h5>
                    <p class="text-white-50">Melodías suaves</p>
                    <button class="btn btn-success w-100 rounded-pill">
                        <i class="bi bi-play-fill"></i> Reproducir
                    </button>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-lg-3">
            <div class="card bg-dark border-0 text-white h-100 shadow">
                <img src="https://via.placeholder.com/300x200/ffeaa7/000?text=Rain" class="card-img-top">
                <div class="card-body">
                    <h5>Lluvia</h5>
                    <p class="text-white-50">Ruido blanco natural</p>
                    <button class="btn btn-success w-100 rounded-pill">
                        <i class="bi bi-play-fill"></i> Reproducir
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>