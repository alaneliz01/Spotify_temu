@page
@model spotify.Pages.CreateUserModel
@{
    Layout = null;
    ViewData["Title"] = "Registro - Spotify";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        body { background: linear-gradient(to bottom, #121212 0%, #000000 100%); height: 100vh; display: flex; align-items: center; justify-content: center; font-family: 'Segoe UI', sans-serif; margin:0; }
        .register-card { width: 400px; background-color: #121212; border-radius: 15px; border: 1px solid #282828; padding: 30px; }
        .form-control { background-color: #121212 !important; border: 1px solid #727272 !important; color: white !important; }
        .form-control:focus { border-color: #1ed760 !important; box-shadow: 0 0 0 1px #1ed760; }
        .btn-register { background-color: #1ed760; color: black; border-radius: 500px; font-weight: bold; border: none; transition: 0.2s; padding: 12px; }
        .btn-register:hover { transform: scale(1.04); background-color: #1db954; }
        .profile-preview { width: 110px; height: 110px; border-radius: 50%; object-fit: cover; border: 2px solid #1ed760; cursor: pointer; transition: 0.3s; }
        .profile-preview:hover { opacity: 0.8; }
    </style>
</head>
<body>
<div class="register-card shadow-lg text-white">
    <div class="text-center mb-4">
        <i class="bi bi-spotify" style="font-size: 2.5rem; color: #1DB954;"></i>
        <h2 class="fw-bold mt-2">Crear cuenta</h2>
    </div>

    <form method="post" enctype="multipart/form-data">
        @* BLOQUE DE FOTO CORREGIDO *@
        <div class="text-center mb-4">
            <label for="inputFoto" class="d-inline-block position-relative">
                <img id="imgPreview" src="https://via.placeholder.com/150/282828/ffffff?text=Subir+Foto" class="profile-preview">
                <div class="mt-2">
                    <span class="small fw-bold text-secondary d-block">FOTO DE PERFIL</span>
                    <span class="text-muted" style="font-size: 0.7rem;">(Opcional)</span>
                </div>
            </label>
            <input type="file" id="inputFoto" asp-for="FotoSubida" class="d-none" accept="image/*" />
        </div>

        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

        <div class="mb-3">
            <label asp-for="NuevoUsuario.Nombre" class="form-label small fw-bold text-secondary">NOMBRE DE USUARIO</label>
            <input asp-for="NuevoUsuario.Nombre" type="text" class="form-control" placeholder="Ej. alaneliz" required>
        </div>

        <div class="mb-3">
            <label asp-for="NuevoUsuario.Password" class="form-label small fw-bold text-secondary">CONTRASEÑA</label>
            <input asp-for="NuevoUsuario.Password" type="password" class="form-control" placeholder="Mínimo 6 caracteres" required>
        </div>

        <button type="submit" class="btn btn-register w-100 mt-3">
            REGISTRARME
        </button>
    </form>

    <div class="text-center mt-4">
        <hr class="border-secondary">
        <p class="text-secondary small mb-1">¿Ya tienes cuenta?</p>
        <a asp-page="/Index" class="text-white small text-decoration-none fw-bold">INICIA SESIÓN AQUÍ</a>
    </div>
</div>

<script>
    document.getElementById('inputFoto').addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = (event) => document.getElementById('imgPreview').src = event.target.result;
            reader.readAsDataURL(file);
        }
    });
</script>
</body>
</html>