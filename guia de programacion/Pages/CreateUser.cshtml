@page
@model spotify.Pages.CreateUserModel
@{
    Layout = null;
    ViewData["Title"] = "Registro - Spotify";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        body {
            background: linear-gradient(to bottom, #121212 0%, #000000 100%);
            height: 100vh;
            margin: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', sans-serif;
        }
        .register-card {
            width: 400px;
            background-color: #121212;
            border-radius: 15px;
            border: 1px solid #282828;
        }
        .form-control {
            background-color: #121212 !important;
            border: 1px solid #727272 !important;
            color: white !important;
        }
        .form-control:focus {
            border-color: #1ed760 !important;
            box-shadow: 0 0 0 1px #1ed760;
        }
        .btn-register {
            background-color: #1ed760;
            color: black;
            border-radius: 500px;
            font-weight: bold;
            transition: 0.2s;
            border: none;
        }
        .btn-register:hover {
            transform: scale(1.04);
            background-color: #1db954;
            color: black;
        }
        .link-spotify:hover {
            color: #1ed760 !important;
            text-decoration: underline !important;
        }
    </style>
</head>
<body>

<div class="register-card shadow-lg p-4 text-white">
    <div class="text-center mb-4">
        <i class="bi bi-spotify" style="font-size: 3rem; color: #1DB954;"></i>
        <h2 class="fw-bold mt-2">Crear cuenta</h2>
    </div>

    <form method="post" onsubmit="alert('¡Usuario registrado! Recuerda tus datos :D')">
        <div class="mb-3">
            <label asp-for="NuevoUsuario.Nombre" class="form-label small fw-bold text-secondary">Nombre de usuario</label>
            <input asp-for="NuevoUsuario.Nombre" type="text" class="form-control py-2" placeholder="Ej. Juan Pérez" required>
        </div>

        <div class="mb-3">
            <label asp-for="NuevoUsuario.Password" class="form-label small fw-bold text-secondary">Contraseña</label>
            <input asp-for="NuevoUsuario.Password" type="password" class="form-control py-2" placeholder="Crea una contraseña" required>
        </div>

        <button type="submit" class="btn btn-register w-100 py-2 mt-3">
            REGISTRARME
        </button>
    </form>

    <div class="text-center mt-4">
        <hr class="border-secondary my-4">
        <p class="text-secondary small mb-1">¿Ya tienes cuenta?</p>
        <a asp-page="/Index" class="text-white small text-decoration-none fw-bold link-spotify">
            INICIA SESIÓN AQUÍ
        </a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

</body>
</html>