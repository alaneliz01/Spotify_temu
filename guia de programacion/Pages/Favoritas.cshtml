@page
@model spotify.Pages.FavoritasModel
@{
    ViewData["ActivePage"] = "favoritas";
    ViewData["Title"] = "Favoritas - SPOTIFY";
}

<div class="favoritas-container p-4 rounded-3" style="background: linear-gradient(135deg, #ff6b6b 0%, #ee5a52 50%, #c44569 100%); min-height: 100%;">
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold text-white">Tus Favoritas ❤️</h1>
        <a href="/" class="btn btn-dark rounded-pill px-3">
            <i class="bi bi-arrow-left"></i>
        </a>
    </div>

    <p class="text-white-50 mb-5">Las canciones que más te gustan, todas en un solo lugar.</p>

    <div class="row g-4">
        <div class="col-md-4 col-lg-3">
            <div class="card bg-dark border-0 text-white h-100 shadow">
                <img src="https://via.placeholder.com/300x200/fd79a8/fff?text=Pop" class="card-img-top">
                <div class="card-body">
                    <h5>Pop Hits</h5>
                    <p class="text-white-50">Tus favoritas del momento</p>
                    <button class="btn btn-success w-100 rounded-pill">
                        <i class="bi bi-play-fill"></i> Reproducir
                    </button>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-lg-3">
            <div class="card bg-dark border-0 text-white h-100 shadow">
                <img src="https://via.placeholder.com/300x200/e17055/fff?text=Indie" class="card-img-top">
                <div class="card-body">
                    <h5>Indie Vibes</h5>
                    <p class="text-white-50">Sonidos alternativos</p>
                    <button class="btn btn-success w-100 rounded-pill">
                        <i class="bi bi-play-fill"></i> Reproducir
                    </button>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-lg-3">
            <div class="card bg-dark border-0 text-white h-100 shadow">
                <img src="https://via.placeholder.com/300x200/6c5ce7/fff?text=Rock" class="card-img-top">
                <div class="card-body">
                    <h5>Rock Mix</h5>
                    <p class="text-white-50">Clásicos y modernos</p>
                    <button class="btn btn-success w-100 rounded-pill">
                        <i class="bi bi-play-fill"></i> Reproducir
                    </button>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-lg-3">
            <div class="card bg-dark border-0 text-white h-100 shadow">
                <img src="https://via.placeholder.com/300x200/00cec9/000?text=Chill" class="card-img-top">
                <div class="card-body">
                    <h5>Chill Mix</h5>
                    <p class="text-white-50">Para relajarte</p>
                    <button class="btn btn-success w-100 rounded-pill">
                        <i class="bi bi-play-fill"></i> Reproducir
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>