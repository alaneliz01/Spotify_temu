@page
@model IndexModel
@{
    Layout = null; // Esto hace que el Login sea una página independiente sin el menú lateral
    ViewData["Title"] = "Iniciar sesión";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Spotify</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            background: linear-gradient(to bottom, #121212 0%, #000000 100%);
            height: 100vh;
            margin: 0;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .login-card {
            width: 400px;
            background-color: #121212;
            border-radius: 15px;
            border: 1px solid #282828;
        }
        .form-control {
            background-color: #121212 !important;
            border: 1px solid #727272 !important;
            color: white !important;
        }
        .form-control:focus {
            border-color: #1ed760 !important;
            box-shadow: 0 0 0 1px #1ed760;
        }
        .btn-login {
            background-color: #1ed760;
            color: black;
            border-radius: 500px;
            font-weight: bold;
            transition: 0.2s;
        }
        .btn-login:hover {
            transform: scale(1.04);
            background-color: #1db954;
        }
    </style>
</head>
<body>

<div class="login-card shadow-lg p-4 text-white">
    <div class="text-center mb-4">
        <i class="bi bi-spotify" style="font-size: 3rem; color: #1DB954;"></i>
        <h2 class="fw-bold mt-2">Spotify</h2>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMensaje))
    {
        <div class="alert alert-danger text-center py-2 small border-0" style="background-color: #e91e63; color: white;">
            @Model.ErrorMensaje
        </div>
    }

    <form method="post">
        <div class="mb-3">
            <label class="form-label small fw-bold text-secondary">Correo electrónico o usuario</label>
            <input type="text" class="form-control py-2" name="usuario" placeholder="Usuario" required>
        </div>

        <div class="mb-3">
            <label class="form-label small fw-bold text-secondary">Contraseña</label>
            <input type="password" class="form-control py-2" name="password" placeholder="Contraseña" required>
        </div>

        <button type="submit" class="btn btn-login w-100 py-2 mt-2">
            INICIAR SESIÓN
        </button>
    </form>

    <div class="text-center mt-4">
        <a href="javascript:void(0)" class="text-secondary small text-decoration-none fw-bold hover-white" onclick="alert('Recuerdala :D')">
            ¿Se te olvidó la contraseña?
        </a>
        
        <hr class="border-secondary my-4">

        <p class="text-secondary small mb-3">¿No tienes cuenta?</p>
        <a asp-page="/CreateUser" class="btn btn-outline-secondary w-100 fw-bold py-2 rounded-pill text-white border-secondary">
            REGÍSTRATE EN SPOTIFY
        </a>
    </div>
</div>

</body>
</html>