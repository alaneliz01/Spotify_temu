@page
@model spotify.Pages.PerfilModel
<div class="container py-5 d-flex justify-content-center">
    <div class="card bg-dark text-white p-4 border-secondary" style="width: 450px; border-radius: 15px;">
        <h2 class="fw-bold mb-4 text-center">Editar Perfil</h2>
        
        <form method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Usuario.Id" />
            
            <div class="text-center mb-4">
                <img id="profileDisplay" src="@Model.Usuario.FotoPerfil" class="rounded-circle shadow" style="width: 120px; height: 120px; object-fit: cover; border: 3px solid #1ed760;">
                <div class="mt-3">
                    <label class="btn btn-outline-light btn-sm rounded-pill">
                        Cambiar foto <input type="file" asp-for="NuevaFoto" hidden id="fileInput" accept="image/*">
                    </label>
                </div>
            </div>

            <div class="mb-3">
                <label class="small text-secondary fw-bold">NOMBRE DE USUARIO</label>
                <input type="text" class="form-control bg-black text-white border-secondary" value="@Model.Usuario.Nombre" readonly />
                <small class="text-muted">El nombre no se puede cambiar.</small>
            </div>

            <div class="mb-4">
                <label class="small text-secondary fw-bold">NUEVA CONTRASEÑA</label>
                <input type="password" asp-for="Usuario.Password" class="form-control bg-black text-white border-secondary" required />
            </div>

            <button type="submit" class="btn btn-success w-100 rounded-pill fw-bold py-2">GUARDAR CAMBIOS</button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('fileInput').onchange = evt => {
            const [file] = document.getElementById('fileInput').files
            if (file) document.getElementById('profileDisplay').src = URL.createObjectURL(file)
        }
    </script>
}