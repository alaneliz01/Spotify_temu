@page "{nombre}"
@model spotify.Pages.PerfilViewModel
@{
    ViewData["Title"] = "Artista - " + Model.NombreArtista;
}

<div class="artist-profile-wrapper">
    @* --- HEADER COMPACTO ELEVADO --- *@
    <div class="artist-header-card d-flex align-items-end p-4 gap-4">
        <div class="header-image-card shadow-lg">
            <img src="@(Model.ArtistaInfo?.FotoPerfil ?? "/img/default-banner.jpg")" alt="@Model.NombreArtista">
        </div>
        
        <div class="header-text-content">
            @if (Model.ArtistaInfo?.EsVerificado == true)
            {
                <div class="d-flex align-items-center gap-1 mb-1">
                    <i class="bi bi-patch-check-fill text-info fs-5"></i>
                    <span class="text-white fw-bold x-small">Artista verificado</span>
                </div>
            }
            <h1 class="display-2 fw-bold text-white mb-0">@Model.NombreArtista</h1>
            <p class="text-white opacity-75 fw-bold mt-1 mb-0">@Model.CancionesArtista.Count() canciones publicadas</p>
        </div>
    </div>

    @* --- CONTROLES PEGADOS AL HEADER --- *@
    <div class="px-4 py-3 d-flex align-items-center gap-4">
        @{ var primeraCancion = Model.CancionesArtista.FirstOrDefault(); }
        @if (primeraCancion != null)
        {
            <a asp-page="/Reproductor" asp-route-id="@primeraCancion.Id" asp-route-contexto="artista" asp-route-valor="@Model.NombreArtista" 
               class="btn btn-success rounded-circle p-0 d-flex align-items-center justify-content-center shadow play-main-btn" style="width: 50px; height: 50px;">
                <i class="bi bi-play-fill fs-3 text-black"></i>
            </a>
        }
        <button class="btn btn-outline-light rounded-pill px-4 fw-bold btn-sm">SIGUIENDO</button>
        <i class="bi bi-three-dots text-secondary fs-4 pointer hover-white"></i>
    </div>

    @* --- TABLA --- *@
    <div class="px-4 pb-5">
        <h3 class="fw-bold text-white mb-3 fs-4">Popular</h3>
        <table class="table table-dark table-hover align-middle mb-0" style="--bs-table-bg: transparent;">
            <thead>
                <tr class="text-secondary small text-uppercase border-bottom border-secondary border-opacity-25">
                    <th style="width: 40px;">#</th>
                    <th>Título</th>
                    <th>Álbum</th>
                    <th class="text-end"><i class="bi bi-clock"></i></th>
                </tr>
            </thead>
            <tbody>
                @{ int j = 1; }
                @foreach (var cancion in Model.CancionesArtista)
                {
                    <tr class="track-row" onclick="window.location.href='/Reproductor/@cancion.Id?contexto=artista&valor=@Uri.EscapeDataString(Model.NombreArtista)'">
                        <td class="text-secondary text-center small">
                            <span class="index-num">@j</span>
                            <i class="bi bi-play-fill text-white d-none play-icon-row"></i>
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <img src="@cancion.RutaPortada" class="rounded" style="width: 40px; height: 40px; object-fit: cover;">
                                <div>
                                    <p class="mb-0 text-white fw-bold song-title small">@cancion.Titulo</p>
                                    @if (cancion.EsFavorito) { <i class="bi bi-heart-fill text-success" style="font-size: 0.8rem;"></i> }
                                </div>
                            </div>
                        </td>
                        <td class="text-secondary small">@cancion.Album</td>
                        <td class="text-secondary text-end small">@cancion.Duracion.ToString(@"m\:ss")</td>
                    </tr>
                    j++;
                }
            </tbody>
        </table>
    </div>
</div>

@section Styles {
    <style>
        .artist-profile-wrapper { background: linear-gradient(to bottom, #2a2a2a 0%, #121212 350px); min-height: 100vh; }
        .artist-header-card { padding-top: 60px !important; } /* Espacio para el navbar si tienes */
        .header-image-card { width: 190px; height: 190px; min-width: 190px; border-radius: 4px; overflow: hidden; }
        .header-image-card img { width: 100%; height: 100%; object-fit: cover; }
        .header-text-content h1 { font-size: clamp(2rem, 6vw, 4.5rem); letter-spacing: -2px; line-height: 1.1; }
        .x-small { font-size: 0.75rem; }
        .track-row:hover { background: rgba(255,255,255,0.1) !important; }
        .track-row:hover .index-num { display: none; }
        .track-row:hover .play-icon-row { display: inline-block !important; }
        .track-row:hover .song-title { color: #1db954 !important; }
        .play-main-btn:hover { transform: scale(1.05); }
    </style>
}