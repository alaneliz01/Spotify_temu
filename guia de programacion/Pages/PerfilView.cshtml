@page "{nombre}"
@model spotify.Pages.PerfilViewModel
@{
    ViewData["Title"] = "Artista - " + Model.NombreArtista;
}

<div class="artist-profile-wrapper">
    @* --- HEADER DEL ARTISTA (Banner) --- *@
    <div class="artist-header" style="background-image: linear-gradient(transparent, rgba(0,0,0,0.9)), url('@(Model.ArtistaInfo?.FotoPerfil ?? "/img/default-banner.jpg")');">
        <div class="header-content p-5">
            @if (Model.ArtistaInfo?.EsVerificado == true)
            {
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-patch-check-fill text-info fs-4"></i>
                    <span class="text-white fw-bold small">Artista verificado</span>
                </div>
            }
            <h1 class="display-1 fw-bold text-white">@Model.NombreArtista</h1>
            <p class="text-white opacity-75">@Model.CancionesArtista.Count() canciones publicadas</p>
        </div>
    </div>

    @* --- CONTROLES DE ACCIÓN --- *@
    <div class="p-4 d-flex align-items-center gap-4">
        @* Botón Play Principal: Inicia la primera canción del artista con el contexto adecuado *@
        @{
            var primeraCancion = Model.CancionesArtista.FirstOrDefault();
        }
        @if (primeraCancion != null)
        {
            <a asp-page="/Reproductor" 
               asp-route-id="@primeraCancion.Id" 
               asp-route-contexto="artista" 
               asp-route-valor="@Model.NombreArtista" 
               class="btn btn-success rounded-circle p-0 d-flex align-items-center justify-content-center shadow-lg play-main-btn" 
               style="width: 56px; height: 56px;">
                <i class="bi bi-play-fill fs-2 text-black"></i>
            </a>
        }
        
        <button class="btn btn-outline-light rounded-pill px-4 fw-bold shadow-sm">SIGUIENDO</button>
        <i class="bi bi-three-dots text-secondary fs-3 pointer hover-white"></i>
    </div>

    @* --- LISTA DE CANCIONES (POPULARES) --- *@
    <div class="px-5 pb-5">
        <h3 class="fw-bold text-white mb-4">Popular</h3>
        
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0" style="--bs-table-bg: transparent;">
                <thead>
                    <tr class="text-secondary small text-uppercase border-bottom border-secondary border-opacity-25">
                        <th class="py-2" style="width: 50px;">#</th>
                        <th class="py-2">Título</th>
                        <th class="py-2">Álbum</th>
                        <th class="py-2 text-end"><i class="bi bi-clock"></i></th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int i = 1;
                    }
                    @foreach (var cancion in Model.CancionesArtista)
                    {
                        @* Modificamos el onclick para incluir contexto y valor *@
                        <tr class="track-row" onclick="window.location.href='/Reproductor/@cancion.Id?contexto=artista&valor=@Uri.EscapeDataString(Model.NombreArtista)'">
                            <td class="text-secondary text-center">
                                <span class="index-num">@i</span>
                                <i class="bi bi-play-fill text-white d-none play-icon-row"></i>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@cancion.RutaPortada" class="rounded shadow-sm" style="width: 40px; height: 40px; object-fit: cover;">
                                    <div>
                                        <p class="mb-0 text-white fw-bold">@cancion.Titulo</p>
                                        @if (cancion.EsFavorito)
                                        {
                                            <div class="d-flex align-items-center gap-1">
                                                <i class="bi bi-heart-fill text-success" style="font-size: 0.7rem;"></i>
                                                <span class="text-success small" style="font-size: 0.75rem;">Favorita</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td class="text-secondary small">@cancion.Album</td>
                            <td class="text-secondary text-end small">@cancion.Duracion.ToString(@"m\:ss")</td>
                        </tr>
                        i++;
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .artist-profile-wrapper {
            background: linear-gradient(to bottom, #2a2a2a 0%, #121212 400px);
            min-height: 100vh;
        }

        .artist-header {
            height: 45vh;
            background-size: cover;
            background-position: center;
            display: flex;
            align-items: flex-end;
            position: relative;
            box-shadow: inset 0 -100px 100px -20px rgba(0,0,0,0.8);
        }

        .header-content h1 {
            font-size: clamp(3rem, 8vw, 6rem); /* Texto responsivo */
            letter-spacing: -2px;
        }

        .track-row {
            cursor: pointer;
            transition: background 0.2s ease;
            border-bottom: 1px solid transparent;
        }

        .track-row:hover {
            background: rgba(255,255,255,0.08) !important;
        }

        /* Efecto de aparecer el icono de play al pasar el mouse por la fila */
        .track-row:hover .index-num { display: none; }
        .track-row:hover .play-icon-row { display: inline-block !important; }

        .track-row:hover .text-secondary {
            color: white !important;
        }

        .play-main-btn {
            transition: transform 0.2s ease, background-color 0.2s ease;
        }
        .play-main-btn:hover {
            transform: scale(1.05);
            background-color: #1fdf64 !important;
        }

        .hover-white:hover { color: white !important; }
        .pointer { cursor: pointer; }
        
        .table-dark { --bs-table-hover-bg: transparent; }
    </style>
}