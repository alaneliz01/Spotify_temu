@page "{id:int}"
@model spotify.Pages.PlaylistModel
@{
    ViewData["Title"] = "Playlist - " + Model.Playlist.Nombre;
}

<div class="artist-profile-wrapper">
    @* --- HEADER COMPACTO ELEVADO --- *@
    <div class="artist-header-card d-flex align-items-end p-4 gap-4">
        <div class="header-image-card shadow-lg d-flex align-items-center justify-content-center bg-dark">
            @if (!string.IsNullOrEmpty(Model.Playlist.Fotoplaylist)) {
                <img src="@Model.Playlist.Fotoplaylist" alt="@Model.Playlist.Nombre">
            } else {
                <i class="bi bi-music-note-beamed text-secondary" style="font-size: 4rem;"></i>
            }
        </div>
        
        <div class="header-text-content">
            <span class="text-white fw-bold x-small text-uppercase">Playlist</span>
            <h1 class="display-2 fw-bold text-white mb-0">@Model.Playlist.Nombre</h1>
            <p class="text-white opacity-75 fw-bold mt-1 mb-0">
                @HttpContext.Session.GetString("UsuarioNombre") • @Model.Playlist.PlaylistCanciones.Count canciones
            </p>
        </div>
    </div>

    @* --- CONTROLES DE ACCIÓN --- *@
    <div class="px-4 py-3 d-flex align-items-center gap-4">
        @if (Model.Playlist.PlaylistCanciones.Any())
        {
            var primera = Model.Playlist.PlaylistCanciones.First();
            <a asp-page="/Reproductor" asp-route-id="@primera.CancionId" asp-route-contexto="playlist" asp-route-valor="@Model.Playlist.Id" 
               class="btn btn-success rounded-circle p-0 d-flex align-items-center justify-content-center shadow play-main-btn" style="width: 50px; height: 50px;">
                <i class="bi bi-play-fill fs-3 text-black"></i>
            </a>
        }

        @* MENÚ DE TRES PUNTOS FUNCIONAL *@
        <div class="dropdown">
            <button class="btn border-0 p-0 bg-transparent text-secondary hover-white" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-three-dots fs-4 pointer"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-dark shadow border-secondary">
                <li>
                    <form method="post" asp-page-handler="Eliminar" asp-route-id="@Model.Playlist.Id" onsubmit="return confirm('¿Estás seguro de que deseas eliminar esta playlist? Esta acción no se puede deshacer.')">
                        <button type="submit" class="dropdown-item text-danger d-flex align-items-center gap-2">
                            <i class="bi bi-trash3"></i> 
                            <span>Eliminar playlist</span>
                        </button>
                    </form>
                </li>
            </ul>
        </div>
    </div>

    @* --- LISTA DE CANCIONES --- *@
    <div class="px-4 pb-5">
        <table class="table table-dark table-hover align-middle mb-0" style="--bs-table-bg: transparent;">
            <thead>
                <tr class="text-secondary small text-uppercase border-bottom border-secondary border-opacity-25">
                    <th style="width: 40px;">#</th>
                    <th>Título</th>
                    <th>Álbum</th>
                    <th class="text-end"><i class="bi bi-clock"></i></th>
                </tr>
            </thead>
            <tbody>
                @{ int i = 1; }
                @foreach (var item in Model.Playlist.PlaylistCanciones)
                {
                    <tr class="track-row" onclick="window.location.href='/Reproductor/@item.CancionId?contexto=playlist&valor=@Model.Playlist.Id'">
                        <td class="text-secondary text-center small">
                            <span class="index-num">@i</span>
                            <i class="bi bi-play-fill text-white d-none play-icon-row"></i>
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <img src="@item.Cancion.RutaPortada" class="rounded" style="width: 40px; height: 40px; object-fit: cover;">
                                <div>
                                    <p class="mb-0 text-white fw-bold song-title small">@item.Cancion.Titulo</p>
                                    <p class="mb-0 text-secondary x-small">@item.Cancion.Artista</p>
                                </div>
                            </div>
                        </td>
                        <td class="text-secondary small">@item.Cancion.Album</td>
                        <td class="text-secondary text-end small">@item.Cancion.Duracion.ToString(@"m\:ss")</td>
                    </tr>
                    i++;
                }
            </tbody>
        </table>
    </div>
</div>

@section Styles {
    <style>
        .artist-profile-wrapper { background: linear-gradient(to bottom, #2a2a2a 0%, #121212 350px); min-height: 100vh; }
        .artist-header-card { padding-top: 60px !important; }
        .header-image-card { width: 190px; height: 190px; min-width: 190px; border-radius: 4px; overflow: hidden; box-shadow: 0 8px 24px rgba(0,0,0,0.5); }
        .header-image-card img { width: 100%; height: 100%; object-fit: cover; }
        .header-text-content h1 { font-size: clamp(2rem, 6vw, 4.5rem); letter-spacing: -2px; line-height: 1.1; }
        .x-small { font-size: 0.75rem; }
        
        /* Efectos de la tabla */
        .track-row { cursor: pointer; transition: 0.2s ease; }
        .track-row:hover { background: rgba(255,255,255,0.1) !important; }
        .track-row:hover .index-num { display: none; }
        .track-row:hover .play-icon-row { display: inline-block !important; }
        .track-row:hover .song-title { color: #1db954 !important; }

        /* Botón Play */
        .play-main-btn { transition: transform 0.2s ease; }
        .play-main-btn:hover { transform: scale(1.05); background-color: #1ed760 !important; }

        .hover-white:hover { color: white !important; }
        .pointer { cursor: pointer; }

        /* Estilo para el dropdown */
        .dropdown-item:active { background-color: #333; }
        .dropdown-menu { background-color: #282828; border: 1px solid #3e3e3e; min-width: 180px; }
    </style>
}