@page
@model spotify.Pages.Premium.PlanesModel
@{
    ViewData["Title"] = "Elige tu Plan - Spotify";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-white">Elige tu plan Premium</h1>
        <p class="fs-5 text-secondary">Escucha sin límites, sin anuncios y con la mejor calidad.</p>
    </div>

    <div class="row justify-content-center g-4">
        @* 1. PLAN INDIVIDUAL *@
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-lg card-custom">
                <div class="p-4 border-bottom border-secondary">
                    <span class="badge bg-primary mb-2">Más popular</span>
                    <h3 class="text-white fw-bold">Individual Prime</h3>
                    <p class="text-white-50 small">1 cuenta premium</p>
                </div>
                <div class="card-body text-white">
                    <ul class="list-unstyled">
                        <li class="mb-3"><i class="bi bi-check2 text-primary me-2"></i> Música sin anuncios</li>
                        <li class="mb-3"><i class="bi bi-check2 text-primary me-2"></i> Calidad de sonido superior</li>
                        <li class="mb-3"><i class="bi bi-check2 text-primary me-2"></i> Modo offline</li>
                    </ul>
                </div>
                <div class="p-4 pt-0 text-center">
                    <h4 class="text-white mb-3">$129.00 <small class="text-secondary" style="font-size: 0.8rem;">/ mes</small></h4>
                    <button type="button" class="btn btn-primary rounded-pill w-100 fw-bold py-2 btn-individual" onclick="abrirPasarela('Individual', '129.00')">
                        OBTENER INDIVIDUAL
                    </button>
                </div>
            </div>
        </div>

        @* 2. PLAN FAMILIAR *@
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-lg card-custom border-highlight">
                <div class="p-4 border-bottom border-secondary">
                    <span class="badge bg-success mb-2">Ahorro Máximo</span>
                    <h3 class="text-white fw-bold">Plan Familiar</h3>
                    <p class="text-white-50 small">Hasta 6 cuentas</p>
                </div>
                <div class="card-body text-white">
                    <ul class="list-unstyled">
                        <li class="mb-3"><i class="bi bi-check2 text-success me-2"></i> Cuentas separadas</li>
                        <li class="mb-3"><i class="bi bi-check2 text-success me-2"></i> Bloqueo de música explícita</li>
                        <li class="mb-3"><i class="bi bi-check2 text-success me-2"></i> Spotify Kids incluido</li>
                    </ul>
                </div>
                <div class="p-4 pt-0 text-center">
                    <h4 class="text-white mb-3">$199.00 <small class="text-secondary" style="font-size: 0.8rem;">/ mes</small></h4>
                    <button type="button" class="btn btn-success rounded-pill w-100 fw-bold py-2" onclick="abrirPasarela('Familiar', '199.00')">
                        OBTENER FAMILIAR
                    </button>
                </div>
            </div>
        </div>

        @* 3. PLAN BLASPHEMOUS *@
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-lg card-blasphemous">
                <div class="p-4 border-bottom border-danger">
                    <span class="badge bg-danger mb-2">PENITENCIA</span>
                    <h3 class="text-white fw-bold">Plan Blasphemous</h3>
                    <p class="text-danger small fw-bold">Expiación de culpas musical.</p>
                </div>
                <div class="card-body text-white">
                    <ul class="list-unstyled">
                        <li class="mb-3"><i class="bi bi-fire text-danger me-2"></i> Audio grabado en Custodia</li>
                        <li class="mb-3"><i class="bi bi-fire text-danger me-2"></i> OST de Blasphemous 1 y 2</li>
                        <li class="mb-3"><i class="bi bi-fire text-danger me-2"></i> Limpia tus culpas</li>
                    </ul>
                </div>
                <div class="p-4 pt-0 text-center">
                    <h4 class="text-white mb-3">$666.00 <small class="text-secondary" style="font-size: 0.8rem;">Lágrimas</small></h4>
                    <button type="button" class="btn btn-danger rounded-pill w-100 fw-bold py-2 btn-milagro" onclick="abrirPasarela('Blasphemous', '666.00')">
                        ACEPTAR PENITENCIA
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="text-center mt-5">
        <a asp-page="/Inicio" class="text-secondary text-decoration-none small fw-bold">
            <i class="bi bi-arrow-left me-1"></i> Volver al inicio
        </a>
    </div>
</div>

@* MODAL DE PAGO ACTUALIZADO CON PAYPAL *@
<div class="modal fade" id="modalPago" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-secondary shadow-lg">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Completar suscripción: <span id="textPlan" class="text-success"></span></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <p class="text-secondary-custom small mb-4">Paga de forma segura sin compartir tus datos bancarios.</p>

                <div class="bg-black p-3 rounded mb-4 d-flex justify-content-between align-items-center">
                    <span id="planNombre" class="fw-bold text-uppercase small">PLAN</span>
                    <span id="planPrecio" class="fs-4 fw-bold text-white"></span>
                </div>

                @* Aquí aparecerán los botones de PayPal *@
                <div id="paypal-button-container"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://www.paypal.com/sdk/js?client-id=test&currency=USD"></script>
    <script>
        let precioSeleccionado = "0.00";
        let nombrePlanSeleccionado = "";

        function abrirPasarela(plan, precio) {
            nombrePlanSeleccionado = plan;
            precioSeleccionado = precio;

            document.getElementById('textPlan').innerText = plan;
            document.getElementById('planNombre').innerText = plan;
            document.getElementById('planPrecio').innerText = "$" + precio;

            // Limpiar contenedor antes de renderizar (evita botones duplicados)
            document.getElementById('paypal-button-container').innerHTML = "";
            renderPayPalButtons();

            var myModal = new bootstrap.Modal(document.getElementById('modalPago'));
            myModal.show();
        }

        function renderPayPalButtons() {
            paypal.Buttons({
                style: { layout: 'vertical', color: 'blue', shape: 'pill', label: 'pay' },
                createOrder: function(data, actions) {
                    return actions.order.create({
                        purchase_units: [{
                            description: "Suscripción " + nombrePlanSeleccionado,
                            amount: { value: precioSeleccionado }
                        }]
                    });
                },
                onApprove: function(data, actions) {
                    return actions.order.capture().then(function(details) {
                        alert('¡Penitencia cumplida, ' + details.payer.name.given_name + '! Tu pago fue exitoso.');
                        window.location.href = "/Inicio";
                    });
                }
            }).render('#paypal-button-container');
        }
    </script>
}

@* TU ESTILO CSS (Sin cambios, solo añadí un par de detalles) *@
<style>
    body {
        background: radial-gradient(circle at top, #121212 0%, #000 100%);
        min-height: 100vh;
    }

    .card-custom {
        background-color: #242424;
        border-radius: 15px;
        transition: all 0.3s ease;
    }

    .border-highlight {
        border: 1px solid #1ed760 !important;
    }

    .card-blasphemous {
        background: linear-gradient(145deg, #1a1a1a 0%, #4a0000 100%);
        border-radius: 15px;
        border: 1px solid #dc3545 !important;
        transition: all 0.3s ease;
    }

        .card-custom:hover, .card-blasphemous:hover {
            transform: translateY(-10px);
        }

    .btn-individual {
        background: linear-gradient(90deg, #00d4ff 0%, #007bff 100%);
        border: none;
        color: white;
    }

    .btn-milagro {
        background: #000;
        border: 1px solid #dc3545 !important;
        color: #dc3545;
    }

        .btn-milagro:hover {
            background: #dc3545;
            color: #fff;
        }

    .text-secondary-custom {
        color: #b3b3b3;
    }
</style>