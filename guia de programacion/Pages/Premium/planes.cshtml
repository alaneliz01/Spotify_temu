@page
@model spotify.Pages.Premium.PlanesModel
@{
    ViewData["Title"] = "Elige tu Plan - Spotify";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-white">Elige tu plan Premium</h1>
        <p class="fs-5 text-secondary">Escucha sin límites, sin anuncios y con la mejor calidad.</p>
    </div>

    <div class="row justify-content-center g-4">
        
        @* 1. PLAN INDIVIDUAL *@
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-lg card-custom">
                <div class="p-4 border-bottom border-secondary">
                    <span class="badge bg-primary mb-2">Más popular</span>
                    <h3 class="text-white fw-bold">Individual Prime</h3>
                    <p class="text-white-50 small">1 cuenta premium</p>
                </div>
                
                <div class="card-body text-white">
                    <ul class="list-unstyled">
                        <li class="mb-3"><i class="bi bi-check2 text-primary me-2"></i> Música sin anuncios</li>
                        <li class="mb-3"><i class="bi bi-check2 text-primary me-2"></i> Calidad de sonido superior</li>
                        <li class="mb-3"><i class="bi bi-check2 text-primary me-2"></i> Modo offline</li>
                    </ul>
                </div>

                <div class="p-4 pt-0 text-center">
                    <h4 class="text-white mb-3">$129.00 <small class="text-secondary" style="font-size: 0.8rem;">/ mes</small></h4>
                    @* Cambiado a button type="button" para abrir el modal *@
                    <button type="button" class="btn btn-primary rounded-pill w-100 fw-bold py-2 shadow-sm border-0 btn-individual" onclick="abrirPasarela('Individual')">
                        OBTENER INDIVIDUAL
                    </button>
                </div>
            </div>
        </div>

        @* 2. PLAN FAMILIAR *@
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-lg card-custom border-highlight">
                <div class="p-4 border-bottom border-secondary">
                    <span class="badge bg-success mb-2">Ahorro Máximo</span>
                    <h3 class="text-white fw-bold">Plan Familiar</h3>
                    <p class="text-white-50 small">Hasta 6 cuentas</p>
                </div>
                
                <div class="card-body text-white">
                    <ul class="list-unstyled">
                        <li class="mb-3"><i class="bi bi-check2 text-success me-2"></i> Cuentas separadas para todos</li>
                        <li class="mb-3"><i class="bi bi-check2 text-success me-2"></i> Bloqueo de música explícita</li>
                        <li class="mb-3"><i class="bi bi-check2 text-success me-2"></i> Spotify Kids incluido</li>
                    </ul>
                </div>

                <div class="p-4 pt-0 text-center">
                    <h4 class="text-white mb-3">$199.00 <small class="text-secondary" style="font-size: 0.8rem;">/ mes</small></h4>
                    <button type="button" class="btn btn-success rounded-pill w-100 fw-bold py-2 shadow-sm border-0" onclick="abrirPasarela('Familiar')">
                        OBTENER FAMILIAR
                    </button>
                </div>
            </div>
        </div>

        @* 3. PLAN BLASPHEMOUS *@
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-lg card-blasphemous">
                <div class="p-4 border-bottom border-danger">
                    <span class="badge bg-danger mb-2">PENITENCIA</span>
                    <h3 class="text-white fw-bold">Plan Blasphemous</h3>
                    <p class="text-danger small fw-bold">Solo para aquellos que desean expiar su culpa y hubieren derrotado al Milagro Doloroso.</p>
                </div>
                
                <div class="card-body text-white">
                    <ul class="list-unstyled">
                        <li class="mb-3"><i class="bi bi-fire text-danger me-2"></i> Audio grabado en Custodia</li>
                        <li class="mb-3"><i class="bi bi-fire text-danger me-2"></i> OST de Blasphemous 1 y 2</li>
                        <li class="mb-3"><i class="bi bi-fire text-danger me-2"></i> Limpia tus culpas con música</li>
                    </ul>
                </div>

                <div class="p-4 pt-0 text-center">
                    <h4 class="text-white mb-3">666 <small class="text-secondary" style="font-size: 0.8rem;">Lágrimas de Enmienda</small></h4>
                    <button type="button" class="btn btn-danger rounded-pill w-100 fw-bold py-2 shadow-sm border-0 btn-milagro" onclick="abrirPasarela('Blasphemous')">
                        ACEPTAR PENITENCIA
                    </button>
                </div>
            </div>
        </div>

    </div>

    <div class="text-center mt-5">
        <a asp-page="/Inicio" class="text-secondary text-decoration-none small fw-bold">
            <i class="bi bi-arrow-left me-1"></i> Volver al inicio
        </a>
    </div>
</div>

@* MODAL DE PAGO *@
<div class="modal fade" id="modalPago" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-secondary shadow-lg">
            <div class="modal-header border-secondary">
                <h5 class="modal-title fw-bold">Finalizar Compra: <span id="textPlan" class="text-info"></span></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="Comprar">
                <div class="modal-body">
                    <input type="hidden" name="tipoPlan" id="inputPlanHidden" />
                    
                    <div class="mb-3">
                        <label class="form-label small text-secondary fw-bold text-uppercase">Número de Tarjeta</label>
                        <input type="text" class="form-control bg-black text-white border-secondary" placeholder="0000 0000 0000 0000" required>
                    </div>
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label small text-secondary fw-bold text-uppercase">Expiración</label>
                            <input type="text" class="form-control bg-black text-white border-secondary" placeholder="MM/AA" required>
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label small text-secondary fw-bold text-uppercase">CVC</label>
                            <input type="password" class="form-control bg-black text-white border-secondary" placeholder="***" required>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="submit" class="btn btn-success w-100 py-2 fw-bold rounded-pill">PAGAR Y ACTIVAR</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function abrirPasarela(plan) {
        document.getElementById('textPlan').innerText = plan;
        document.getElementById('inputPlanHidden').value = plan;
        var myModal = new bootstrap.Modal(document.getElementById('modalPago'));
        myModal.show();
    }
</script>

<style>
    body {
        background: radial-gradient(circle at top, #121212 0%, #000 100%);
        min-height: 100vh;
    }

    .card-custom {
        background-color: #242424;
        border-radius: 15px;
        transition: all 0.3s ease;
    }

    .border-highlight {
        border: 1px solid #1ed760 !important;
    }

    .card-blasphemous {
        background: linear-gradient(145deg, #1a1a1a 0%, #4a0000 100%);
        border-radius: 15px;
        border: 1px solid #dc3545 !important;
        transition: all 0.3s ease;
    }

        .card-custom:hover, .card-blasphemous:hover {
            transform: translateY(-10px);
        }

    .card-custom:hover {
        box-shadow: 0 10px 30px rgba(30, 215, 96, 0.2) !important;
    }

    .card-blasphemous:hover {
        box-shadow: 0 10px 30px rgba(220, 53, 69, 0.4) !important;
    }

    .btn-individual {
        background: linear-gradient(90deg, #00d4ff 0%, #007bff 100%);
    }

    .btn-milagro {
        background: #000;
        border: 1px solid #dc3545 !important;
        color: #dc3545;
    }

        .btn-milagro:hover {
            background: #dc3545;
            color: #fff;
        }
</style>