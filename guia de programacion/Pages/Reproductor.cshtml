@page "{id:int}"
@model spotify.Pages.ReproductorModel

<div class="player-layout-wrapper">
    @* PANEL IZQUIERDO: PLAYLIST *@
    <div class="playlist-panel flex-grow-1 p-5">
        <h3 class="fw-bold text-white-50 small mb-4">A CONTINUACIÓN</h3>
        <div class="playlist-container">
            @foreach (var c in Model.ListaReproduccion)
            {
                <div class="playlist-item @(c.Id == Model.Cancion.Id ? "active" : "") d-flex align-items-center px-3 py-2">
                    <a asp-page="/Reproductor" asp-route-id="@c.Id" asp-route-contexto="@Model.Contexto" asp-route-valor="@Model.Valor" class="d-flex align-items-center flex-grow-1 text-decoration-none">
                        <img src="@c.RutaPortada" class="item-portada me-3">
                        <p class="item-titulo text-white fw-bold mb-0">@c.Titulo</p>
                    </a>
                    <a asp-page="/PerfilView" asp-route-nombre="@c.Artista" class="text-secondary small ms-2 hover-white text-decoration-none">@c.Artista</a>
                </div>
            }
        </div>
    </div>

    @* PANEL DERECHO: INFO GLASS *@
    <div class="artist-panel p-4">
        <div class="album-container mb-4 text-center">
            <img src="@Model.Cancion.RutaPortada" class="album-art-square shadow-lg">
        </div>

        <div class="info-card p-3 rounded-4 mb-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="h3 fw-bold text-white mb-0">@Model.Cancion.Titulo</h2>
                    <a asp-page="/PerfilView" asp-route-nombre="@Model.Cancion.Artista" class="h5 text-secondary text-decoration-none hover-white">@Model.Cancion.Artista</a>
                </div>
                <form method="post" asp-page-handler="ToggleFavorito" asp-route-id="@Model.Cancion.Id">
                    <input type="hidden" name="tiempo" id="tiempoInput" value="0" />
                    <input type="hidden" name="contexto" value="@Model.Contexto" />
                    <input type="hidden" name="valor" value="@Model.Valor" />
                    <button type="submit" class="btn-fav" onclick="document.getElementById('tiempoInput').value = document.getElementById('audioEngine').currentTime">
                        <i class="bi @(Model.Cancion.EsFavorito ? "bi-heart-fill text-success" : "bi-heart") fs-3"></i>
                    </button>
                </form>
            </div>
        </div>

        @* SECCIÓN ACERCA DEL ARTISTA *@
        <a asp-page="/PerfilView" asp-route-nombre="@Model.Cancion.Artista" class="text-decoration-none">
            <div class="about-artist p-3 rounded-4 mt-3 hover-bright">
                <div class="d-flex align-items-center gap-3">
                    <div class="artist-mini-img" style="background-image: url('@Model.FotoArtista')"></div>
                    <div>
                        <p class="fw-bold text-white mb-0">@Model.Cancion.Artista @(Model.ArtistaVerificado ? "✔" : "")</p>
                        <p class="small text-secondary mb-0">Ver perfil</p>
                    </div>
                </div>
            </div>
        </a>
    </div>
</div>

@* CONTROLES *@
<div class="bottom-player-bar">
    <div class="d-flex flex-column align-items-center justify-content-center h-100">
        <div class="d-flex align-items-center gap-4 mb-2">
            <a asp-page="/Reproductor" asp-route-id="@Model.AnteriorCancionId" asp-route-contexto="@Model.Contexto" asp-route-valor="@Model.Valor" class="nav-btn"><i class="bi bi-skip-start-fill"></i></a>
            <button class="btn-play-main" onclick="const a = document.getElementById('audioEngine'); a.paused ? a.play() : a.pause()"><i class="bi bi-play-fill"></i></button>
            <a asp-page="/Reproductor" asp-route-id="@Model.SiguienteCancionId" asp-route-contexto="@Model.Contexto" asp-route-valor="@Model.Valor" class="nav-btn"><i class="bi bi-skip-end-fill"></i></a>
        </div>
        <audio id="audioEngine" controls autoplay class="custom-player-style w-50"
               onloadedmetadata="this.currentTime = @Model.TiempoActual"
               onended="window.location.href='/Reproductor/@Model.SiguienteCancionId?contexto=@Model.Contexto&valor=@Model.Valor'">
            <source src="@Model.Cancion.RutaArchivo" type="audio/mpeg">
        </audio>
    </div>
</div>