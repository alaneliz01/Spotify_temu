@page "{id:int}"
@model spotify.Pages.ReproductorModel

<div class="player-page-wrapper">
    <div class="header-controls">
        <a asp-page="/Inicio" class="close-button"><i class="bi bi-x-lg"></i></a>
    </div>

    <div class="container text-center">
        <div class="mb-4">
            <img src="@Model.Cancion.RutaPortada" class="main-album-art shadow-lg">
        </div>

        <div class="mb-5">
            <h1 class="display-4 fw-bold text-white">@Model.Cancion.Titulo</h1>
            <h3 class="text-secondary">@Model.Cancion.Artista</h3>
        </div>

        <div class="player-interface mx-auto" style="max-width: 500px;">
            <div class="d-flex align-items-center justify-content-center gap-4 mb-3">
                <button class="btn-icon text-secondary"><i class="bi bi-shuffle"></i></button>
                <button class="btn-icon text-white"><i class="bi bi-skip-start-fill fs-3"></i></button>
                
                <button class="btn-play-main" id="btnToggle">
                    <i class="bi bi-play-fill" id="playIcon"></i>
                </button>

                <button class="btn-icon text-white"><i class="bi bi-skip-end-fill fs-3"></i></button>
                <button class="btn-icon text-secondary"><i class="bi bi-repeat"></i></button>
            </div>

            <div class="d-flex align-items-center gap-2">
                <span id="timeCurrent" class="small text-secondary" style="min-width: 35px;">0:00</span>
                <div class="progress-container flex-grow-1" id="progressArea">
                    <div class="progress-bar-fill" id="barFill"></div>
                </div>
                <span id="timeTotal" class="small text-secondary" style="min-width: 35px;">0:00</span>
            </div>
        </div>

        <audio id="audioEngine" src="@Model.Cancion.RutaArchivo" autoplay></audio>
    </div>
</div>

<style>
    .player-page-wrapper {
        background: #121212;
        min-height: 100vh;
        display: flex;
        align-items: center;
        color: white;
    }

    .main-album-art {
        width: 350px;
        height: 350px;
        object-fit: cover;
        border-radius: 8px;
    }

    /* Botón Play Blanco Circular */
    .btn-play-main {
        width: 56px;
        height: 56px;
        background: white;
        border: none;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        color: black;
        transition: transform 0.2s;
    }
    .btn-play-main:hover { transform: scale(1.05); }

    .btn-icon { background: none; border: none; font-size: 1.2rem; }

    /* Barra de progreso estilo Spotify */
    .progress-container {
        height: 4px;
        background: #4f4f4f;
        border-radius: 2px;
        cursor: pointer;
        position: relative;
    }
    .progress-bar-fill {
        height: 100%;
        background: #1db954; /* El verde de tu imagen */
        width: 0%;
        border-radius: 2px;
    }
    .progress-container:hover .progress-bar-fill { background: #1ed760; }
</style>

<script>
    const audio = document.getElementById('audioEngine');
    const btnToggle = document.getElementById('btnToggle');
    const playIcon = document.getElementById('playIcon');
    const barFill = document.getElementById('barFill');
    const progressArea = document.getElementById('progressArea');
    const timeCurrent = document.getElementById('timeCurrent');
    const timeTotal = document.getElementById('timeTotal');

    // Play y Pause
    btnToggle.onclick = () => {
        if (audio.paused) {
            audio.play();
            playIcon.className = "bi bi-pause-fill";
        } else {
            audio.pause();
            playIcon.className = "bi bi-play-fill";
        }
    };

    // Actualizar barra y números de tiempo
    audio.ontimeupdate = () => {
        const pct = (audio.currentTime / audio.duration) * 100;
        barFill.style.width = pct + "%";
        timeCurrent.innerText = formatTime(audio.currentTime);
        if (audio.duration) timeTotal.innerText = formatTime(audio.duration);
    };

    // Hacer clic en la barra para cambiar el tiempo
    progressArea.onclick = (e) => {
        const width = progressArea.clientWidth;
        const clickX = e.offsetX;
        audio.currentTime = (clickX / width) * audio.duration;
    };

    function formatTime(secs) {
        const min = Math.floor(secs / 60);
        const s = Math.floor(secs % 60);
        return min + ":" + (s < 10 ? "0" + s : s);
    }
</script>