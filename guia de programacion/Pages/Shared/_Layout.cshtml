@using Microsoft.AspNetCore.Http
@inject spotify.Data.ApplicationDbContext _context
@{
    // 1. Lógica para cargar playlists en el Sidebar
    var userIdStr = Context.Session.GetString("UsuarioId");
    List<spotify.Models.Playlist> playlistsSidebar = new();

    if (!string.IsNullOrEmpty(userIdStr))
    {
        try 
        {
            int uId = int.Parse(userIdStr);
            // Traemos las playlists del usuario logueado
            playlistsSidebar = _context.Playlists
                .Where(p => p.UsuarioId == uId)
                .ToList();
        }
        catch { 
            /* Silenciamos errores de base de datos */ 
        }
    }

    // 2. Datos del usuario para el Navbar superior
    var nombreUsuario = Context.Session.GetString("UsuarioNombre") ?? "Usuario";
    var fotoUsuario = Context.Session.GetString("UsuarioFoto");
    var esVerificado = Context.Session.GetString("EsVerificado") == "True";
    var esAdmin = Context.Session.GetString("EsAdmin") == "true";
    var esPremium = Context.Session.GetString("EsPremium") == "true";
    var tipoPlan = Context.Session.GetString("TipoPlan") ?? "Gratis";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Spotify</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    
    <style>
        html, body { height: 100%; background-color: #000; overflow: hidden; font-family: 'Circular', sans-serif; }
        .main-wrapper { height: 100vh; overflow: hidden; }
        .main-content { overflow-y: auto; background: linear-gradient(to bottom, #1e1e1e, #121212); border-radius: 8px; margin: 8px 8px 8px 0; scrollbar-width: thin; }
        
        /* Sidebar Styles */
        .sidebar-playlist-item {
            padding: 8px 12px; border-radius: 6px; transition: 0.3s;
            text-decoration: none; display: flex; align-items: center; color: #b3b3b3;
        }
        .sidebar-playlist-item:hover { background-color: #1a1a1a; color: white; }
        .sidebar-playlist-img { width: 32px; height: 32px; object-fit: cover; border-radius: 4px; margin-right: 12px; }
        .sidebar-scroll { overflow-y: auto; flex-grow: 1; scrollbar-width: none; }
        .sidebar-scroll::-webkit-scrollbar { display: none; }

        /* Estilo especial para Likes */
        .liked-sidebar-icon {
            background: linear-gradient(135deg, #450af5, #8e8ee5);
            width: 32px; height: 32px; border-radius: 4px; margin-right: 12px;
            display: flex; align-items: center; justify-content: center;
        }

        .btn-profile:hover { background-color: #282828 !important; transform: scale(1.02); transition: 0.2s; }
        .text-verified { color: #00f2ff !important; text-shadow: 0 0 10px rgba(0, 242, 255, 0.4); }
        .img-nav-profile { width: 28px; height: 28px; object-fit: cover; border-radius: 50%; }
        .badge-plan { font-size: 0.6rem; margin-left: 8px; }
    </style>
</head>
<body>
    <div class="d-flex h-100 w-100 p-0 m-0 main-wrapper">
        
        @* SIDEBAR *@
        <div class="sidebar p-3 d-flex flex-column flex-shrink-0" style="width: 240px; background-color: #000;">
            <div class="logo-container mb-4 pb-2 px-2 text-white">
                <i class="bi bi-spotify text-success fs-3 me-2"></i>
                <span class="fw-bold fs-4">Spotify</span>
            </div>
            
            <ul class="nav nav-pills flex-column mb-3">
                <li class="nav-item mb-1">
                    <a class="nav-link text-white @(ViewData["ActivePage"]?.ToString() == "inicio" ? "active bg-dark" : "")" asp-page="/Inicio">
                        <i class="bi bi-house-door-fill me-3"></i>Inicio
                    </a>
                </li>
                <li class="nav-item mb-1">
                    <a class="nav-link text-white" asp-page="/Buscar">
                        <i class="bi bi-search me-3"></i>Buscar
                    </a>
                </li>
                <li class="nav-item mb-1">
                    <a class="nav-link text-white @(ViewData["ActivePage"]?.ToString() == "biblioteca" ? "active bg-dark" : "")" asp-page="/Biblioteca">
                        <i class="bi bi-collection-play-fill me-3"></i>Tu Biblioteca
                    </a>
                </li>
            </ul>

            <div class="sidebar-scroll">
                <p class="text-secondary small fw-bold px-2 text-uppercase mb-2" style="font-size: 0.7rem; letter-spacing: 1px;">Tus Listas</p>
                
                @* ENLACE FIJO A LIKES *@
                <a asp-page="/Favoritas" class="sidebar-playlist-item mb-1">
                    <div class="liked-sidebar-icon shadow-sm">
                        <i class="bi bi-heart-fill text-white" style="font-size: 0.8rem;"></i>
                    </div>
                    <span class="text-truncate small fw-semibold">Tus me gusta</span>
                </a>

                @* PLAYLISTS DEL USUARIO *@
                @foreach (var p in playlistsSidebar)
                {
                    <a asp-page="/Playlist" asp-route-id="@p.Id" class="sidebar-playlist-item mb-1">
                        @if (!string.IsNullOrEmpty(p.Fotoplaylist)) 
                        {
                            <img src="@p.Fotoplaylist" class="sidebar-playlist-img shadow-sm">
                        } 
                        else 
                        {
                            <div class="sidebar-playlist-img bg-dark d-flex align-items-center justify-content-center text-secondary border border-secondary border-opacity-10">
                                <i class="bi bi-music-note-beamed"></i>
                            </div>
                        }
                        <span class="text-truncate small fw-semibold">@p.Nombre</span>
                    </a>
                }
            </div>
        </div>

        @* CONTENIDO PRINCIPAL *@
        <div class="flex-grow-1 main-content p-4 text-white">
            
            @* TOP NAVBAR *@
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="d-flex gap-2">
                    <button class="btn btn-black rounded-circle bg-black text-white p-1 px-2 opacity-75" onclick="history.back()"><i class="bi bi-chevron-left"></i></button>
                    <button class="btn btn-black rounded-circle bg-black text-white p-1 px-2 opacity-75" onclick="history.forward()"><i class="bi bi-chevron-right"></i></button>
                </div>

                <div class="d-flex align-items-center">
                    <div class="dropdown">
                        <button class="btn btn-black rounded-pill dropdown-toggle px-2 py-1 fw-bold text-white border-0 d-flex align-items-center btn-profile shadow-lg"
                                type="button" data-bs-toggle="dropdown" style="background-color: #000;">
                            
                            @if (!string.IsNullOrEmpty(fotoUsuario)) {
                                <img src="@fotoUsuario" class="img-nav-profile me-2" alt="Perfil" />
                            } else {
                                <i class="bi bi-person-circle me-2 fs-5"></i>
                            }

                            <span class="me-1">@nombreUsuario</span>
                            
                            @if (esVerificado) {
                                <i class="bi bi-patch-check-fill text-verified ms-1" title="Verificado"></i>
                            }

                            @if (esAdmin) {
                                <span class="badge bg-warning text-dark badge-plan">ADMIN</span>
                            }
                            else if (esPremium && tipoPlan != "Gratis") {
                                <span class="badge @(tipoPlan == "Blasphemous" ? "bg-danger" : "bg-info text-dark") badge-plan">
                                    @tipoPlan.ToUpper()
                                </span>
                            }
                        </button>

                        <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end shadow-lg border-secondary mt-2">
                            <li><a class="dropdown-item py-2" asp-page="/Perfil"><i class="bi bi-person-circle me-2 text-secondary"></i> Perfil</a></li>
                            
                            @if (esAdmin) {
                                <li><a class="dropdown-item py-2 text-warning" asp-page="/Admin/Panel"><i class="bi bi-shield-lock me-2"></i> Panel Música</a></li>
                                <li><a class="dropdown-item py-2 text-info" asp-page="/Admin/ListaUsuarios"><i class="bi bi-people me-2"></i> Usuarios</a></li>
                            }

                            <li><hr class="dropdown-divider border-secondary mx-2"></li>
                            <li><a class="dropdown-item py-2 text-danger" asp-page="/Index"><i class="bi bi-box-arrow-right me-2"></i> Salir</a></li>
                        </ul>
                    </div>
                </div>
            </div>

            @RenderBody()

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>