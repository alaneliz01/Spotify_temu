@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Spotify</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    
    <style>
        html, body { height: 100%; background-color: #000; overflow: hidden; }
        .main-wrapper { height: 100vh; overflow: hidden; }
        .main-content { overflow-y: auto; background: linear-gradient(to bottom, #1e1e1e, #121212); border-radius: 8px; margin: 8px 8px 8px 0; }
        .btn-profile:hover { background-color: #282828 !important; transform: scale(1.05); transition: 0.2s; }
        .text-verified { color: #00f2ff !important; text-shadow: 0 0 10px rgba(0, 242, 255, 0.4); }
        
        .img-nav-profile {
            width: 28px;
            height: 28px;
            object-fit: cover;
            border-radius: 50%;
        }
    </style>
</head>
<body>
    <div class="d-flex h-100 w-100 p-0 m-0 main-wrapper">
        @* SIDEBAR *@
        <div class="sidebar p-4 d-flex flex-column flex-shrink-0" style="width: 240px; background-color: #000;">
            <div class="logo-container mb-4 pb-3">
                <i class="bi bi-spotify text-success fs-3 me-2"></i>
                <span class="fw-bold text-white fs-4">Spotify</span>
            </div>
            <ul class="nav nav-pills flex-column mb-4">
                <li class="nav-item mb-1"><a class="nav-link text-white" asp-page="/Inicio"><i class="bi bi-house-door-fill me-3"></i>Inicio</a></li>
                <li class="nav-item mb-1"><a class="nav-link text-white" asp-page="/Buscar"><i class="bi bi-search me-3"></i>Buscar</a></li>
                <li class="nav-item mb-1"><a class="nav-link text-white" asp-page="/Biblioteca"><i class="bi bi-collection-play-fill me-3"></i>Tu Biblioteca</a></li>
            </ul>
        </div>

        <div class="flex-grow-1 main-content p-4 text-white">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="d-flex gap-2">
                    <button class="btn btn-black rounded-circle bg-black text-white p-1 px-2 opacity-50" onclick="history.back()"><i class="bi bi-chevron-left"></i></button>
                    <button class="btn btn-black rounded-circle bg-black text-white p-1 px-2 opacity-50" onclick="history.forward()"><i class="bi bi-chevron-right"></i></button>
                </div>

                <div class="d-flex align-items-center">
                    @{
                        var nombreUsuario = Context.Session.GetString("UsuarioNombre") ?? "Usuario";
                        var fotoUsuario = Context.Session.GetString("UsuarioFoto");
                        var esPremium = Context.Session.GetString("EsPremium") == "true";
                        var esAdmin = Context.Session.GetString("EsAdmin") == "true";
                        var esVerificado = Context.Session.GetString("EsVerificado") == "True";
                        var tipoPlan = Context.Session.GetString("TipoPlan") ?? "Gratis";
                    }

                    <div class="dropdown">
                        <button class="btn btn-black rounded-pill dropdown-toggle px-2 py-1 fw-bold text-white shadow border-0 d-flex align-items-center btn-profile"
                                type="button" data-bs-toggle="dropdown" style="background-color: #000;">
                            
                            @if (!string.IsNullOrEmpty(fotoUsuario))
                            {
                                <img src="@fotoUsuario" class="img-nav-profile me-2" alt="Perfil" />
                            }
                            else
                            {
                                <i class="bi bi-person-circle me-2 fs-5"></i>
                            }

                            <span class="me-1">@nombreUsuario</span>
                            
                            @if (esVerificado)
                            {
                                <i class="bi bi-patch-check-fill text-verified ms-1" title="Artista Verificado"></i>
                            }

                            @if (esAdmin)
                            {
                                <span class="badge bg-warning text-dark ms-2" style="font-size: 0.6rem;">ADMIN</span>
                            }
                            else if (esPremium && tipoPlan != "Gratis")
                            {
                                <span class="badge @(tipoPlan == "Blasphemous" ? "bg-danger" : "bg-info text-dark") ms-2" style="font-size: 0.6rem;">
                                    @tipoPlan.ToUpper()
                                </span>
                            }
                        </button>

                        <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end shadow border-secondary">
                            @* NUEVO: Botón de Perfil visible para todos *@
                            <li><a class="dropdown-item" asp-page="/Perfil"><i class="bi bi-person-circle me-2"></i> Perfil</a></li>
                            
                            <li><hr class="dropdown-divider border-secondary"></li>

                            @if (esAdmin)
                            {
                                <li><a class="dropdown-item text-warning" asp-page="/Admin/Panel"><i class="bi bi-shield-lock me-2"></i> Panel Música</a></li>
                                <li><a class="dropdown-item text-info" asp-page="/Admin/ListaUsuarios"><i class="bi bi-people me-2"></i> Usuarios</a></li>
                            }
                            else
                            {
                                @if (esVerificado)
                                {
                                    <li><a class="dropdown-item text-verified fw-bold" asp-page="/CancionVerificado"><i class="bi bi-megaphone me-2"></i> Portal de Artista</a></li>
                                }
                                <li><a class="dropdown-item" asp-page="/Premium/Planes"><i class="bi bi-star me-2"></i> @(esPremium ? "Mi Plan" : "Obtener Prime")</a></li>
                            }
                            <li><hr class="dropdown-divider border-secondary"></li>
                            <li><a class="dropdown-item text-danger" asp-page="/Index"><i class="bi bi-box-arrow-right me-2"></i> Salir</a></li>
                        </ul>
                    </div>
                </div>
            </div>
            @RenderBody()
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>