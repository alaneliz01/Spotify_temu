@page
@model spotify.Pages.InicioModel
@{
    ViewData["Title"] = "Spotify - Inicio";
    ViewData["ActivePage"] = "inicio";
}

<div class="content-wrapper p-4">
    @* --- SECCIÓN DE BIENVENIDA --- *@
    <div class="welcome-header mb-5">
        <h1 class="fw-bold display-5 text-white">
            @{
                var hora = DateTime.Now.Hour;
                var saludo = hora < 12 ? "Buenos días" : hora < 19 ? "Buenas tardes" : "Buenas noches";
            }
            @saludo, @Model.NombreUsuario
        </h1>
    </div>

    @* --- SECCIÓN DE CANCIONES --- *@
    <div class="mb-4">
        <h3 class="fw-bold text-white h4 mb-0">Recomendados para ti</h3>
    </div>

    <div class="row g-4 mb-5">
        @if (Model.Canciones.Any())
        {
            @foreach (var cancion in Model.Canciones.Take(6))
            {
                <div class="col-6 col-md-4 col-lg-3 col-xl-2">
                    <a asp-page="/Reproductor" asp-route-id="@cancion.Id" class="text-decoration-none">
                        <div class="spotify-card h-100">
                            <div class="img-container position-relative mb-3">
                                <img src="@cancion.RutaPortada" class="img-fluid rounded shadow-lg main-card-img" onerror="this.src='/img/default-album.png'">
                                <div class="play-btn-card shadow-lg"><i class="bi bi-play-fill fs-2"></i></div>
                            </div>
                            <h6 class="fw-bold text-white text-truncate mb-1">@cancion.Titulo</h6>
                            <p class="text-secondary small text-truncate mb-0">@cancion.Artista</p>
                        </div>
                    </a>
                </div>
            }
        }
    </div>

    @* --- NUEVA SECCIÓN: ARTISTAS RANDOM --- *@
    <div class="mb-4 mt-5">
        <h3 class="fw-bold text-white h4 mb-0">Artistas populares</h3>
    </div>

    <div class="row g-4 mb-5">
        @if (Model.ArtistasRandom.Any())
        {
            @foreach (var artista in Model.ArtistasRandom)
            {
                <div class="col-6 col-md-4 col-lg-3 col-xl-2">
                    <a asp-page="/PerfilView" asp-route-nombre="@artista.Nombre" class="text-decoration-none">
                        <div class="spotify-card h-100 text-center">
                            <div class="img-container mb-3">
                                @* IMAGEN CIRCULAR *@
                                <img src="@artista.FotoPerfil" class="img-fluid rounded-circle shadow-lg artist-card-img"
                                     style="aspect-ratio: 1/1; object-fit: cover;"
                                     onerror="this.src='/img/default-user.png'">
                                
                                <div class="play-btn-card shadow-lg" style="right: 15%; bottom: 15%;">
                                    <i class="bi bi-play-fill fs-2"></i>
                                </div>
                            </div>
                            <h6 class="fw-bold text-white text-truncate mb-1">@artista.Nombre</h6>
                            <p class="text-secondary small mb-0">Artista @(artista.EsVerificado ? "✔" : "")</p>
                        </div>
                    </a>
                </div>
            }
        }
    </div>
</div>

@section Styles {
    <style>
        .content-wrapper {
            background: linear-gradient(to bottom, #1e1e1e 0%, #121212 300px);
            min-height: 100vh;
        }

        .main-card-img {
            aspect-ratio: 1/1;
            object-fit: cover;
            width: 100%;
            transition: 0.3s;
        }

        /* Estilo específico para las fotos de artistas */
        .artist-card-img {
            width: 100%;
            max-width: 150px;
            margin: 0 auto;
            transition: 0.3s;
        }

        .spotify-card:hover .artist-card-img,
        .spotify-card:hover .main-card-img {
            transform: scale(1.04);
            filter: brightness(1.2);
        }

        .text-truncate {
            display: block;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
    </style>
}